{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-usage-monitor",
  "version": "0.1.0",
  "identifier": "com.tauri-app.ai-usage-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Usage Monitor",
        "width": 430,
        "height": 720,
        "minWidth": 390,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
